<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>My Playlist Room</title>
<meta name="description" content="기분에 맞는 노래를 골라 듣는 플레이리스트 홈페이지">
<style>
  :root{
    --bg:#0b0c1a;--bg2:#12142a;--card:#171a33;--line:#ffffff1f;
    --text:#f2f3ff;--muted:#9aa0c8;--accent:#ff6f91;--accent2:#7c8cff;
    --radius:20px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);line-height:1.6;
    font-family:"Pretendard","Segoe UI","Malgun Gothic","Apple SD Gothic Neo",system-ui,sans-serif;
    -webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
  .wrap{width:min(1100px,100% - 40px);margin:0 auto}

  /* 배경 장식 */
  .glow{position:fixed;inset:0;pointer-events:none;z-index:-1;overflow:hidden}
  .glow i{position:absolute;border-radius:50%;filter:blur(110px);opacity:.35}
  .glow i:nth-child(1){width:480px;height:480px;background:#ff6f91;top:-140px;left:-120px}
  .glow i:nth-child(2){width:520px;height:520px;background:#5b6bff;top:30%;right:-200px}
  .glow i:nth-child(3){width:420px;height:420px;background:#17d6b0;bottom:-160px;left:25%;opacity:.2}

  /* 상단 네비 */
  nav{position:sticky;top:0;z-index:20;backdrop-filter:blur(14px);background:#0b0c1acc;border-bottom:1px solid var(--line)}
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:60px}
  .logo{font-weight:800;letter-spacing:.02em;display:flex;align-items:center;gap:10px}
  .eq{display:inline-flex;align-items:flex-end;gap:2px;height:18px}
  .eq b{width:3px;border-radius:2px;background:var(--accent);animation:eq 1s ease-in-out infinite}
  .eq b:nth-child(1){animation-delay:-.2s}.eq b:nth-child(2){animation-delay:-.6s;background:var(--accent2)}
  .eq b:nth-child(3){animation-delay:-.4s}.eq b:nth-child(4){animation-delay:-.8s;background:var(--accent2)}
  .eq b:nth-child(5){animation-delay:-.1s}
  @keyframes eq{0%,100%{height:20%}50%{height:100%}}
  nav ul{display:flex;gap:6px;list-style:none}
  nav ul a{padding:8px 14px;border-radius:999px;color:var(--muted);font-size:14px;transition:.2s}
  nav ul a:hover{color:var(--text);background:#ffffff14}

  /* 히어로 */
  .hero{padding:84px 0 56px;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}
  .hero .tag{display:inline-block;padding:6px 14px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:13px;margin-bottom:22px}
  .hero h1{font-size:clamp(38px,6.4vw,72px);line-height:1.08;font-weight:900;letter-spacing:-.03em}
  .hero h1 span{background:linear-gradient(100deg,var(--accent),#ffb36b 45%,var(--accent2));-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p.lead{margin-top:20px;color:var(--muted);font-size:17px;max-width:30em}
  .cta{margin-top:30px;display:flex;gap:12px;flex-wrap:wrap}
  .btn{padding:13px 22px;border-radius:999px;font-weight:700;font-size:15px;transition:.2s}
  .btn.primary{background:linear-gradient(100deg,var(--accent),#ff9a6b);color:#1a0a10}
  .btn.primary:hover{transform:translateY(-2px);box-shadow:0 10px 30px #ff6f9144}
  .btn.ghost{border:1px solid var(--line);background:#ffffff0d}
  .btn.ghost:hover{background:#ffffff1a}

  /* 오늘의 한 곡 */
  .today{position:relative;padding:26px;border-radius:28px;background:linear-gradient(160deg,#ffffff1c,#ffffff08);
    border:1px solid var(--line);box-shadow:0 30px 80px #00000066;overflow:hidden}
  .today small{color:var(--muted);letter-spacing:.14em;font-size:12px}
  .disc{width:150px;height:150px;border-radius:50%;margin:20px auto 18px;position:relative;
    background:conic-gradient(from 0deg,#222,#444,#222,#555,#222);box-shadow:0 10px 40px #000a;animation:spin 7s linear infinite}
  .disc::before{content:"";position:absolute;inset:34%;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2))}
  .disc::after{content:"";position:absolute;inset:47%;border-radius:50%;background:var(--bg)}
  @keyframes spin{to{transform:rotate(360deg)}}
  .today h3{font-size:22px;text-align:center;line-height:1.3}
  .today .artist{text-align:center;color:var(--muted);margin-top:4px}
  .today .from{text-align:center;margin-top:10px;font-size:13px;color:var(--accent2)}
  .today .row{display:flex;gap:10px;justify-content:center;margin-top:20px;flex-wrap:wrap}
  .pill{padding:9px 16px;border-radius:999px;font-size:14px;font-weight:600;border:1px solid var(--line);background:#ffffff10;transition:.2s}
  .pill:hover{background:#ffffff22}
  .pill.hot{background:var(--accent);border-color:var(--accent);color:#1a0a10}

  /* 섹션 공통 */
  section{padding:56px 0}
  .sec-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:26px}
  .sec-head h2{font-size:clamp(26px,4vw,38px);letter-spacing:-.02em}
  .sec-head p{color:var(--muted);margin-top:4px}

  /* 필터 + 검색 */
  .tools{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:26px}
  .chips{display:flex;gap:8px;flex-wrap:wrap}
  .chip{padding:8px 16px;border-radius:999px;border:1px solid var(--line);color:var(--muted);font-size:14px;transition:.2s}
  .chip:hover{color:var(--text)}
  .chip.on{background:var(--text);color:#0b0c1a;border-color:var(--text);font-weight:700}
  .search{margin-left:auto;position:relative}
  .search input{width:220px;max-width:100%;padding:10px 16px;border-radius:999px;border:1px solid var(--line);background:#ffffff0d;color:var(--text);font:inherit;outline:none}
  .search input:focus{border-color:var(--accent2)}

  /* 플레이리스트 카드 */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:20px}
  .card{position:relative;border-radius:var(--radius);padding:24px;min-height:210px;display:flex;flex-direction:column;justify-content:space-between;
    text-align:left;overflow:hidden;border:1px solid #ffffff22;transition:transform .25s,box-shadow .25s;
    background:linear-gradient(145deg,var(--c1),var(--c2))}
  .card::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 85% 0%,#ffffff2e,transparent 55%);pointer-events:none}
  .card:hover{transform:translateY(-6px) rotate(-.4deg);box-shadow:0 22px 50px #0009}
  .card .emoji{font-size:40px;filter:drop-shadow(0 4px 10px #0006)}
  .card h3{font-size:23px;margin-top:10px;letter-spacing:-.01em}
  .card p{font-size:14px;opacity:.85;margin-top:2px}
  .card .meta{display:flex;justify-content:space-between;align-items:center;margin-top:18px;font-size:13px}
  .card .meta .go{padding:6px 12px;border-radius:999px;background:#00000040;font-weight:700}
  .tags{display:flex;gap:6px}
  .tags span{padding:3px 10px;border-radius:999px;background:#00000035;font-size:12px}
  .empty{color:var(--muted);padding:30px 0;text-align:center;grid-column:1/-1}

  /* 모달 */
  dialog{border:0;padding:0;background:transparent;color:var(--text);max-width:none;max-height:none;margin:auto}
  dialog::backdrop{background:#04040cd0;backdrop-filter:blur(6px)}
  .modal{width:min(640px,100vw - 24px);max-height:88vh;overflow:auto;border-radius:26px;background:var(--bg2);border:1px solid var(--line);box-shadow:0 40px 100px #000}
  .m-top{padding:28px 28px 22px;position:relative;background:linear-gradient(145deg,var(--c1),var(--c2))}
  .m-top .emoji{font-size:46px}
  .m-top h3{font-size:28px;margin-top:6px}
  .m-top p{opacity:.88}
  .m-close{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:50%;background:#00000050;font-size:18px}
  .m-close:hover{background:#00000090}
  .tracks{list-style:none;padding:10px 12px 16px}
  .track{display:grid;grid-template-columns:28px 1fr auto auto;gap:12px;align-items:center;padding:12px;border-radius:14px;transition:.15s}
  .track:hover{background:#ffffff0f}
  .track .n{color:var(--muted);text-align:center;font-variant-numeric:tabular-nums}
  .track .t{font-weight:700;line-height:1.3}
  .track .a{color:var(--muted);font-size:14px}
  .heart{font-size:20px;color:#ffffff55;transition:.15s;padding:4px 8px}
  .heart:hover{transform:scale(1.2)}
  .heart.on{color:var(--accent)}
  .play{padding:7px 14px;border-radius:999px;background:#ffffff14;font-size:13px;font-weight:700;white-space:nowrap}
  .play:hover{background:var(--accent);color:#1a0a10}
  .embed{padding:0 16px 8px}
  .embed iframe{width:100%;aspect-ratio:16/9;border:0;border-radius:14px}

  /* 즐겨찾기 */
  .favs{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
  .favs li{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:var(--card);border:1px solid var(--line)}
  .favs .info{flex:1;min-width:0}
  .favs .t{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .favs .a{color:var(--muted);font-size:13px}

  /* 소개 */
  .about{display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center;padding:32px;border-radius:26px;background:var(--card);border:1px solid var(--line)}
  .avatar{width:110px;height:110px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));display:grid;place-items:center;font-size:48px}
  .about h3{font-size:24px}
  .about p{color:var(--muted);margin-top:8px}
  .links{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}

  footer{padding:40px 0 60px;text-align:center;color:var(--muted);font-size:13px;border-top:1px solid var(--line);margin-top:30px}

  /* 토스트 */
  #toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,40px);opacity:0;pointer-events:none;
    padding:12px 20px;border-radius:999px;background:#fff;color:#0b0c1a;font-weight:700;font-size:14px;transition:.3s;z-index:50}
  #toast.show{transform:translate(-50%,0);opacity:1}

  @media (max-width:820px){
    .hero{grid-template-columns:1fr;padding-top:56px}
    nav ul a{padding:8px 10px}
    .search{margin-left:0;width:100%}.search input{width:100%}
    .about{grid-template-columns:1fr;text-align:center;justify-items:center}
    .links{justify-content:center}
  }
  @media (max-width:520px){
    nav ul li:nth-child(3){display:none}
    .track{grid-template-columns:22px 1fr auto}
    .track .play{display:none}
  }
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div class="glow"><i></i><i></i><i></i></div>

<nav>
  <div class="wrap">
    <a href="#top" class="logo"><span class="eq"><b></b><b></b><b></b><b></b><b></b></span><span id="siteName"></span></a>
    <ul>
      <li><a href="#lists">플레이리스트</a></li>
      <li><a href="#favs">찜한 곡</a></li>
      <li><a href="#about">소개</a></li>
    </ul>
  </div>
</nav>

<main class="wrap" id="top">
  <header class="hero">
    <div>
      <span class="tag" id="heroTag"></span>
      <h1 id="heroTitle"></h1>
      <p class="lead" id="heroLead"></p>
      <div class="cta">
        <a class="btn primary" href="#lists">플레이리스트 둘러보기</a>
        <button class="btn ghost" id="ctaRandom">🎲 아무 노래나 틀어줘</button>
      </div>
    </div>
    <aside class="today" aria-live="polite">
      <small>TODAY'S PICK · 오늘의 한 곡</small>
      <div class="disc"></div>
      <h3 id="tTitle"></h3>
      <div class="artist" id="tArtist"></div>
      <div class="from" id="tFrom"></div>
      <div class="row">
        <a class="pill hot" id="tPlay" target="_blank" rel="noopener">▶ 듣기</a>
        <button class="pill" id="tHeart">♡ 찜하기</button>
        <button class="pill" id="tNext">↻ 다른 곡</button>
      </div>
    </aside>
  </header>

  <section id="lists">
    <div class="sec-head">
      <div><h2>지금 기분은 어때요?</h2><p>분위기를 고르면 거기에 맞는 노래를 모아뒀어요.</p></div>
    </div>
    <div class="tools">
      <div class="chips" id="chips"></div>
      <label class="search"><input id="q" type="search" placeholder="곡 · 가수 검색" autocomplete="off"></label>
    </div>
    <div class="grid" id="grid"></div>
  </section>

  <section id="favs">
    <div class="sec-head">
      <div><h2>내가 찜한 곡 ♥</h2><p>하트를 누른 곡이 이 브라우저에 저장돼요.</p></div>
    </div>
    <ul class="favs" id="favList"></ul>
  </section>

  <section id="about">
    <div class="about">
      <div class="avatar">🎧</div>
      <div>
        <h3 id="aboutTitle"></h3>
        <p id="aboutText"></p>
        <div class="links" id="links"></div>
      </div>
    </div>
  </section>
</main>

<footer>© <span id="year"></span> <span id="footName"></span> · 곡 정보는 제목/가수만 표기하며, 재생은 외부 사이트로 연결돼요.</footer>

<dialog id="dlg"><div class="modal" id="modal"></div></dialog>
<div id="toast"></div>

<script>
/* =====================================================
   ✏️ 여기만 고치면 내 사이트가 됩니다!
   ===================================================== */
const SITE = {
  name: 'My Playlist Room',
  tag:  '🎵 분위기별 플레이리스트',
  title: '오늘의 기분에<br><span>딱 맞는 노래</span>',
  lead: '비 오는 날, 새벽 드라이브, 집중이 필요한 순간까지. 상황마다 제가 아끼는 노래를 골라 모아뒀어요.',
  aboutTitle: '이 방의 주인',
  aboutText: '노래 듣는 걸 좋아하는 사람이 만든 작은 음악방입니다. 새로운 곡은 틈틈이 업데이트할게요. 추천하고 싶은 노래가 있다면 편하게 알려주세요!',
  links: [
    { label: 'Instagram', url: '#' },
    { label: 'YouTube',   url: '#' },
    { label: 'Email',     url: 'mailto:hello@example.com' }
  ]
};

/* 곡 형식: [제목, 가수]  또는  [제목, 가수, '직접 연결할 링크']
   링크를 안 적으면 유튜브 검색으로 연결됩니다.
   embed 에 유튜브 재생목록 ID(예: 'PLxxxxxxxx')를 넣으면 카드 안에서 바로 재생돼요. */
const PLAYLISTS = [
  { id:'rain', emoji:'☔', title:'비 오는 날', desc:'창밖 빗소리랑 같이 듣는 노래',
    tags:['감성'], c1:'#3b5bdb', c2:'#1c2a6b', embed:'',
    tracks:[['비도 오고 그래서','헤이즈'],['비','폴킴'],['Set Fire to the Rain','Adele'],['Riders on the Storm','The Doors'],['Rain','태연']] },

  { id:'drive', emoji:'🌙', title:'새벽 드라이브', desc:'텅 빈 도로를 달릴 때',
    tags:['밤'], c1:'#8e2de2', c2:'#2a1065', embed:'',
    tracks:[['Midnight City','M83'],['Nightcall','Kavinsky'],['Sunset Lover','Petit Biscuit'],['밤편지','아이유'],['Redbone','Childish Gambino']] },

  { id:'focus', emoji:'📚', title:'집중 모드', desc:'가사 없이 몰입하고 싶을 때',
    tags:['집중'], c1:'#0f9b8e', c2:'#0b4f55', embed:'',
    tracks:[['Experience','Ludovico Einaudi'],['Time','Hans Zimmer'],['River Flows in You','Yiruma'],["Comptine d'un autre été",'Yann Tiersen'],['Weightless','Marconi Union']] },

  { id:'cafe', emoji:'☕', title:'카페 감성', desc:'느긋한 오후, 따뜻한 커피 한 잔',
    tags:['감성'], c1:'#e0803a', c2:'#7a3b12', embed:'',
    tracks:[['Better Together','Jack Johnson'],['Banana Pancakes','Jack Johnson'],['Sunday Morning','Maroon 5'],['Fly Me to the Moon','Frank Sinatra'],['Cheek to Cheek','Ella Fitzgerald & Louis Armstrong']] },

  { id:'gym', emoji:'🔥', title:'운동할 때', desc:'심박수 올려주는 텐션 업 곡',
    tags:['에너지'], c1:'#ee4b4b', c2:'#7a1020', embed:'',
    tracks:[['Eye of the Tiger','Survivor'],['Lose Yourself','Eminem'],["Can't Hold Us",'Macklemore & Ryan Lewis'],["Don't Stop Me Now",'Queen'],['Stronger','Kanye West']] },

  { id:'blue', emoji:'💧', title:'새벽 감성 충전', desc:'괜히 센치해지는 밤에',
    tags:['감성','밤'], c1:'#5a6a8a', c2:'#232a43', embed:'',
    tracks:[['Someone Like You','Adele'],['Fix You','Coldplay'],['나의 옛날이야기','아이유'],['거리에서','성시경'],['Skinny Love','Bon Iver']] }
];
/* ===================================================== */

const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const yt = (t,a) => 'https://www.youtube.com/results?search_query=' + encodeURIComponent(a + ' ' + t);
const key = (pl,t) => pl.id + '|' + t[0] + '|' + t[1];

/* 저장소 (막혀 있어도 동작하도록) */
let favs = [];
try { favs = JSON.parse(localStorage.getItem('pl_favs') || '[]'); } catch(e) {}
const saveFavs = () => { try { localStorage.setItem('pl_favs', JSON.stringify(favs)); } catch(e) {} };
const isFav = k => favs.includes(k);

let filter = '전체', query = '', current = null, today = null;

/* 기본 텍스트 채우기 */
document.title = SITE.name;
$('#siteName').textContent = SITE.name;
$('#footName').textContent = SITE.name;
$('#year').textContent = new Date().getFullYear();
$('#heroTag').textContent = SITE.tag;
$('#heroTitle').innerHTML = SITE.title;
$('#heroLead').textContent = SITE.lead;
$('#aboutTitle').textContent = SITE.aboutTitle;
$('#aboutText').textContent = SITE.aboutText;
$('#links').innerHTML = SITE.links.map(l => `<a class="pill" href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.label)}</a>`).join('');

/* 토스트 */
let tt;
function toast(msg){ const el=$('#toast'); el.textContent=msg; el.classList.add('show'); clearTimeout(tt); tt=setTimeout(()=>el.classList.remove('show'),1800); }

/* 필터 칩 */
function renderChips(){
  const tags = ['전체', ...new Set(PLAYLISTS.flatMap(p => p.tags))];
  $('#chips').innerHTML = tags.map(t => `<button class="chip${t===filter?' on':''}" data-t="${esc(t)}">${esc(t)}</button>`).join('');
}
$('#chips').addEventListener('click', e => {
  const b = e.target.closest('.chip'); if(!b) return;
  filter = b.dataset.t; renderChips(); renderGrid();
});
$('#q').addEventListener('input', e => { query = e.target.value.trim().toLowerCase(); renderGrid(); });

/* 카드 그리드 */
function renderGrid(){
  const list = PLAYLISTS.filter(p => {
    const byTag = filter === '전체' || p.tags.includes(filter);
    if(!byTag) return false;
    if(!query) return true;
    return p.title.toLowerCase().includes(query) || p.desc.toLowerCase().includes(query) ||
      p.tracks.some(t => (t[0] + ' ' + t[1]).toLowerCase().includes(query));
  });
  $('#grid').innerHTML = list.length ? list.map(p => `
    <button class="card" data-id="${p.id}" style="--c1:${p.c1};--c2:${p.c2}">
      <div>
        <div class="emoji">${p.emoji}</div>
        <h3>${esc(p.title)}</h3>
        <p>${esc(p.desc)}</p>
      </div>
      <div class="meta">
        <div class="tags">${p.tags.map(t=>`<span>#${esc(t)}</span>`).join('')}</div>
        <span class="go">${p.tracks.length}곡 ▸</span>
      </div>
    </button>`).join('') : '<div class="empty">찾는 결과가 없어요 🥲</div>';
}
$('#grid').addEventListener('click', e => {
  const c = e.target.closest('.card'); if(!c) return;
  openList(PLAYLISTS.find(p => p.id === c.dataset.id));
});

/* 모달 */
const dlg = $('#dlg');
function openList(pl){
  current = pl;
  const m = $('#modal');
  m.innerHTML = `
    <div class="m-top" style="--c1:${pl.c1};--c2:${pl.c2}">
      <button class="m-close" aria-label="닫기">✕</button>
      <div class="emoji">${pl.emoji}</div>
      <h3>${esc(pl.title)}</h3>
      <p>${esc(pl.desc)}</p>
    </div>
    ${pl.embed ? `<div class="embed"><iframe src="https://www.youtube.com/embed/videoseries?list=${encodeURIComponent(pl.embed)}" title="${esc(pl.title)}" allowfullscreen loading="lazy"></iframe></div>` : ''}
    <ol class="tracks">
      ${pl.tracks.map((t,i)=>`
        <li class="track">
          <span class="n">${i+1}</span>
          <div><div class="t">${esc(t[0])}</div><div class="a">${esc(t[1])}</div></div>
          <button class="heart${isFav(key(pl,t))?' on':''}" data-i="${i}" aria-label="찜하기">${isFav(key(pl,t))?'♥':'♡'}</button>
          <a class="play" href="${esc(t[2]||yt(t[0],t[1]))}" target="_blank" rel="noopener">▶ 듣기</a>
        </li>`).join('')}
    </ol>`;
  if(!dlg.open) dlg.showModal();
  m.scrollTop = 0;
}
$('#modal').addEventListener('click', e => {
  if(e.target.closest('.m-close')){ dlg.close(); return; }
  const h = e.target.closest('.heart'); if(!h) return;
  const t = current.tracks[+h.dataset.i], k = key(current,t);
  toggleFav(k);
  h.classList.toggle('on', isFav(k)); h.textContent = isFav(k) ? '♥' : '♡';
});
dlg.addEventListener('click', e => { if(e.target === dlg) dlg.close(); });  // 바깥 클릭 시 닫기

/* 찜 */
function toggleFav(k){
  if(isFav(k)){ favs = favs.filter(x => x !== k); toast('찜을 해제했어요'); }
  else { favs.push(k); toast('♥ 찜한 곡에 추가했어요'); }
  saveFavs(); renderFavs(); renderToday();
}
function findTrack(k){
  const [id,title,artist] = k.split('|');
  const pl = PLAYLISTS.find(p => p.id === id); if(!pl) return null;
  const t = pl.tracks.find(t => t[0] === title && t[1] === artist);
  return t ? { pl, t } : null;
}
function renderFavs(){
  const items = favs.map(findTrack).filter(Boolean);
  $('#favList').innerHTML = items.length ? items.map(({pl,t}) => `
    <li>
      <span style="font-size:24px">${pl.emoji}</span>
      <div class="info"><div class="t">${esc(t[0])}</div><div class="a">${esc(t[1])}</div></div>
      <a class="play" href="${esc(t[2]||yt(t[0],t[1]))}" target="_blank" rel="noopener">▶</a>
      <button class="heart on" data-k="${esc(key(pl,t))}" aria-label="찜 해제">♥</button>
    </li>`).join('') : '<li style="grid-column:1/-1;justify-content:center;color:var(--muted)">아직 찜한 곡이 없어요. 마음에 드는 곡에 ♡ 를 눌러보세요!</li>';
}
$('#favList').addEventListener('click', e => {
  const h = e.target.closest('.heart'); if(!h) return;
  toggleFav(h.dataset.k);
});

/* 오늘의 한 곡 */
function pickRandom(){
  const all = PLAYLISTS.flatMap(pl => pl.tracks.map(t => ({pl,t})));
  let n; do { n = all[Math.floor(Math.random()*all.length)]; } while(all.length>1 && today && n.t === today.t);
  today = n; renderToday();
}
function renderToday(){
  if(!today) return;
  const {pl,t} = today, k = key(pl,t);
  $('#tTitle').textContent = t[0];
  $('#tArtist').textContent = t[1];
  $('#tFrom').textContent = pl.emoji + ' ' + pl.title + ' 플레이리스트';
  $('#tPlay').href = t[2] || yt(t[0],t[1]);
  $('#tHeart').textContent = isFav(k) ? '♥ 찜함' : '♡ 찜하기';
}
$('#tNext').addEventListener('click', pickRandom);
$('#tHeart').addEventListener('click', () => { if(today) toggleFav(key(today.pl,today.t)); });
$('#ctaRandom').addEventListener('click', () => {
  pickRandom();
  window.open($('#tPlay').href, '_blank', 'noopener');
});

/* 시작 */
renderChips(); renderGrid(); renderFavs(); pickRandom();
</script>
</body>
</html>
